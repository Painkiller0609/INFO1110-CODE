def create_student(profile,club):#create a function that get 2 list and name it to profile and club
    student = {
        "name": profile[0],
        "study_area": profile[1],
        "year": int(profile[2]),
        "main_interest": club[0],
        "social_score": int(club[2]),
        "skill_score": int(club[3]),
        "hobbies": club[1].split(",")#when detect , will split the content before and behind to string
    }#the output will has the []square blankets
    return student


def read_clubs(filename):
    try:# Try to open the file.
        file = open(filename,"r")#open the file and get the data from the file
    except  FileNotFoundError:
        return False# If the file does not exist, return False instead of # allowing the program to crash
    
    listdata = []#create a list the question ask a list of dictionary#line 27 
    for line in file: #a string will occupy a line 
        useful_category = ["academic","creative","culture","sport","volunteering","social"]# Remove spaces and newline characters from the
        # beginning and end of the line.
        line = line.strip()#delete the front and behind white space
        
        new_line = line.split(",")   
        A = new_line[2].split("|")
        
        name = new_line[0]
        category = new_line[1]
        keywords = A

        if category not in useful_category:
            continue#when meet the condition,skip this loop
        
        clubs = {
            "name": name,
            "category": category,
            "keywords": keywords
        }
        listdata.append(clubs)#add the diction to the list
    return listdata
def match_clubs(student, clubs):
    matches = []

    for club in clubs:
        score = 0

        if student["main_interest"] == club["category"]:
            score = score + 3

        for keyword in club["keywords"]:
            if keyword in student["hobbies"]:
                score = score + 1

        if student["social_score"] >= 60 and "social" in club["keywords"]:
            score = score + 1

        if student["skill_score"] >= 60 and ("skills" in club["keywords"] or "career" in club["keywords"] or "study" in club["keywords"]):
            score = score + 1

        match = {
            "name": club["name"],
            "score": score
        }

        matches.append(match)

    score_list = []
# Create a list for sorting.
# -score puts the highest score first.
# [1] is used for the club name and [2] is used for the score later.
    for match in matches:
        score_list.append([
            -match["score"],
            match["name"],
            match["score"]
        ])

    score_list.sort()

    first_matches = score_list[:2]

    filename = student["name"] + ".txt"
    file = open(filename, "w")
    # Write the first recommendation to the file.
    file.write("First Club Recommendation\n")
    file.write('Name: "' + first_matches[0][1] + '"\n')
    file.write("Score: " + str(first_matches[0][2]) + "\n")
    # Write the second recommendation.
    file.write("\nSecond Club Recommendation\n")
    file.write('Name: "' + first_matches[1][1] + '"\n')
    file.write("Score: " + str(first_matches[1][2]) + "\n")
    # Close the file after writing.
    file.close()
     # Return the complete information for the top two matches.
    # recommendations[0] = [-highest_score, club_name, highest_score]
    # recommendations[1] = [-second_score, club_name, second_score]
    return [first_matches[0], first_matches[1]]



